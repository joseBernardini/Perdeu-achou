rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function objectPath(objectId) {
      return /databases/$(database)/documents/objects/$(objectId);
    }

    function claimPath(claimId) {
      return /databases/$(database)/documents/claims/$(claimId);
    }

    function pendingClaimPath(objectId, requesterId) {
      return /databases/$(database)/documents/pendingClaims/$(objectId + '_' + requesterId);
    }

    function isActiveUser() {
      return signedIn()
        && exists(userPath(uid()))
        && get(userPath(uid())).data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && get(userPath(uid())).data.role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }

    function changedOnly(fields) {
      return incoming().diff(existing()).affectedKeys().hasOnly(fields);
    }

    function textBetween(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isCode(value, prefix) {
      return value is string && value.matches('^' + prefix + '-[0-9A-HJKMNP-TV-Z]{8}$');
    }

    function isPastOrTodayDate(value) {
      return value is string
        && value.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && isRealDateNotInFuture(value.split('-'));
    }

    function isRealDateNotInFuture(parts) {
      return isRealDate(timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])), parts);
    }

    function isRealDate(date, parts) {
      return date.year() == int(parts[0])
        && date.month() == int(parts[1])
        && date.day() == int(parts[2])
        && date <= request.time + duration.value(1, 'd');
    }

    function isReviewedNow() {
      return incoming().reviewedBy == uid() && incoming().reviewedAt == request.time;
    }

    function activeClaimOf(data) {
      return data.get('activeClaimId', null);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && hasExactly(['uid', 'displayName', 'email', 'profileType', 'role', 'createdAt', 'active'])
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
        && textBetween(incoming().displayName, 3, 120)
        && incoming().profileType in ['aluno', 'funcionario', 'nao_informado']
        && incoming().role == 'user'
        && incoming().active == true
        && incoming().createdAt == request.time;

      allow update: if isOwner(userId)
        && existing().active == true
        && changedOnly(['displayName', 'profileType'])
        && textBetween(incoming().displayName, 3, 120)
        && incoming().profileType in ['aluno', 'funcionario', 'nao_informado'];

      allow delete: if false;
    }

    function isPublicObjectStatus(status) {
      return status in ['disponivel', 'em_devolucao', 'devolvido'];
    }

    function objectReviewDecision(objectId) {
      return existing().status == 'pendente_aprovacao'
        && incoming().status in ['disponivel', 'reprovado']
        && existing().createdBy != uid()
        && isReviewedNow()
        && activeClaimOf(incoming()) == null;
    }

    function objectStartsReturn(objectId) {
      return existing().status == 'disponivel'
        && incoming().status == 'em_devolucao'
        && changedOnly(['status', 'updatedAt', 'activeClaimId'])
        && isCode(incoming().activeClaimId, 'SOL')
        && getAfter(claimPath(incoming().activeClaimId)).data.status == 'aprovada'
        && getAfter(claimPath(incoming().activeClaimId)).data.objectId == objectId;
    }

    function objectCancelsReturn(objectId) {
      return existing().status == 'em_devolucao'
        && incoming().status == 'disponivel'
        && changedOnly(['status', 'updatedAt', 'activeClaimId'])
        && activeClaimOf(incoming()) == null
        && isCode(activeClaimOf(existing()), 'SOL')
        && getAfter(claimPath(activeClaimOf(existing()))).data.status == 'rejeitada';
    }

    function objectCompletesReturn(objectId) {
      return existing().status == 'em_devolucao'
        && incoming().status == 'devolvido'
        && changedOnly(['status', 'updatedAt', 'reviewedBy', 'reviewedAt'])
        && isReviewedNow()
        && isCode(activeClaimOf(existing()), 'SOL')
        && getAfter(claimPath(activeClaimOf(existing()))).data.status == 'concluida';
    }

    function objectReopens(objectId) {
      return isReviewedNow()
        && activeClaimOf(incoming()) == null
        && ((existing().status == 'devolvido' && incoming().status == 'disponivel')
          || (existing().status == 'reprovado' && incoming().status == 'pendente_aprovacao'));
    }

    match /objects/{objectId} {
      allow get: if resource != null
        && (isPublicObjectStatus(existing().status)
          || (signedIn() && existing().createdBy == uid())
          || isAdmin());

      allow list: if isPublicObjectStatus(existing().status)
        || (signedIn() && existing().createdBy == uid())
        || isAdmin();

      allow create: if isActiveUser()
        && isCode(objectId, 'OBJ')
        && hasExactly([
          'code', 'title', 'category', 'description', 'locationFound', 'dateFound', 'notes',
          'status', 'createdBy', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt', 'activeClaimId'
        ])
        && incoming().code == objectId
        && textBetween(incoming().title, 3, 80)
        && incoming().category in ['eletronicos', 'documentos', 'materiais-escolares', 'acessorios', 'vestuario', 'outros']
        && textBetween(incoming().description, 10, 500)
        && textBetween(incoming().locationFound, 3, 120)
        && isPastOrTodayDate(incoming().dateFound)
        && textBetween(incoming().notes, 0, 300)
        && incoming().status == 'pendente_aprovacao'
        && incoming().createdBy == uid()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().reviewedBy == null
        && incoming().reviewedAt == null
        && incoming().activeClaimId == null;

      allow update: if isAdmin()
        && changedOnly(['status', 'updatedAt', 'reviewedBy', 'reviewedAt', 'activeClaimId'])
        && incoming().updatedAt == request.time
        && (objectReviewDecision(objectId)
          || objectStartsReturn(objectId)
          || objectCancelsReturn(objectId)
          || objectCompletesReturn(objectId)
          || objectReopens(objectId));

      allow delete: if false;
    }

    function claimApproval(claimId) {
      return existing().status == 'pendente'
        && incoming().status == 'aprovada'
        && get(objectPath(existing().objectId)).data.status == 'disponivel'
        && getAfter(objectPath(existing().objectId)).data.status == 'em_devolucao'
        && getAfter(objectPath(existing().objectId)).data.activeClaimId == claimId
        && !existsAfter(pendingClaimPath(existing().objectId, existing().requesterId));
    }

    function claimRejection() {
      return existing().status == 'pendente'
        && incoming().status == 'rejeitada'
        && !existsAfter(pendingClaimPath(existing().objectId, existing().requesterId));
    }

    function claimApprovalCancel() {
      return existing().status == 'aprovada'
        && incoming().status == 'rejeitada'
        && getAfter(objectPath(existing().objectId)).data.status == 'disponivel';
    }

    function claimCompletion(claimId) {
      return existing().status == 'aprovada'
        && incoming().status == 'concluida'
        && getAfter(objectPath(existing().objectId)).data.status == 'devolvido'
        && getAfter(objectPath(existing().objectId)).data.activeClaimId == claimId;
    }

    match /claims/{claimId} {
      allow get: if signedIn()
        && resource != null
        && (existing().requesterId == uid() || isAdmin());

      allow list: if signedIn()
        && (existing().requesterId == uid() || isAdmin());

      allow create: if isActiveUser()
        && isCode(claimId, 'SOL')
        && hasExactly([
          'objectId', 'objectCode', 'requesterId', 'message', 'additionalInfo',
          'status', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'
        ])
        && incoming().requesterId == uid()
        && isCode(incoming().objectId, 'OBJ')
        && incoming().objectCode == incoming().objectId
        && textBetween(incoming().message, 30, 1000)
        && textBetween(incoming().additionalInfo, 0, 500)
        && incoming().status == 'pendente'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().reviewedBy == null
        && incoming().reviewedAt == null
        && exists(objectPath(incoming().objectId))
        && get(objectPath(incoming().objectId)).data.status == 'disponivel'
        && getAfter(pendingClaimPath(incoming().objectId, uid())).data.claimId == claimId;

      allow update: if isAdmin()
        && existing().requesterId != uid()
        && changedOnly(['status', 'updatedAt', 'reviewedBy', 'reviewedAt'])
        && incoming().updatedAt == request.time
        && isReviewedNow()
        && (claimApproval(claimId) || claimRejection() || claimApprovalCancel() || claimCompletion(claimId));

      allow delete: if false;
    }

    function ownsPendingClaim(lockId) {
      return signedIn() && lockId.matches('^OBJ-[0-9A-HJKMNP-TV-Z]{8}_' + uid() + '$');
    }

    match /pendingClaims/{lockId} {
      allow get: if ownsPendingClaim(lockId) || isAdmin();
      allow list: if false;

      allow create: if isActiveUser()
        && ownsPendingClaim(lockId)
        && hasExactly(['objectId', 'requesterId', 'claimId', 'createdAt'])
        && incoming().requesterId == uid()
        && lockId == incoming().objectId + '_' + uid()
        && incoming().createdAt == request.time
        && isCode(incoming().claimId, 'SOL')
        && !exists(claimPath(incoming().claimId))
        && getAfter(claimPath(incoming().claimId)).data.requesterId == uid()
        && getAfter(claimPath(incoming().claimId)).data.objectId == incoming().objectId
        && getAfter(claimPath(incoming().claimId)).data.status == 'pendente';

      allow update: if false;

      allow delete: if isAdmin()
        && getAfter(claimPath(existing().claimId)).data.status != 'pendente';
    }

    function auditTargetPath(targetType, targetId) {
      return targetType == 'objeto' ? objectPath(targetId) : claimPath(targetId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && hasExactly(['type', 'targetType', 'targetId', 'actorId', 'actorRole', 'details', 'result', 'createdAt'])
        && incoming().type in [
          'objeto_aprovado', 'objeto_rejeitado', 'objeto_reaberto', 'solicitacao_aprovada',
          'solicitacao_rejeitada', 'aprovacao_cancelada', 'objeto_devolvido'
        ]
        && incoming().targetType in ['objeto', 'solicitacao']
        && (isCode(incoming().targetId, 'OBJ') || isCode(incoming().targetId, 'SOL'))
        && incoming().actorId == uid()
        && incoming().actorRole == 'admin'
        && incoming().result == 'sucesso'
        && incoming().createdAt == request.time
        && incoming().details is map
        && incoming().details.keys().hasOnly(['from', 'to', 'reason', 'objectId', 'requestId', 'objectStatus'])
        && incoming().details.keys().hasAll(['from', 'to'])
        && (!('reason' in incoming().details) || textBetween(incoming().details.reason, 10, 300))
        && getAfter(auditTargetPath(incoming().targetType, incoming().targetId)).data.status == incoming().details.to;

      allow update, delete: if false;
    }
  }
}
