rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'admin'
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function textBetween(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isPublicObjectStatus(status) {
      return status in ['disponivel', 'em_devolucao', 'devolvido'];
    }

    function objectPath(objectId) {
      return /databases/$(database)/documents/objects/$(objectId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'profileType', 'role', 'createdAt', 'active'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && textBetween(request.resource.data.displayName, 1, 120)
        && request.resource.data.profileType in ['aluno', 'funcionario', 'nao_informado']
        && request.resource.data.role == 'user'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'profileType'])
        && textBetween(request.resource.data.displayName, 1, 120)
        && request.resource.data.profileType in ['aluno', 'funcionario', 'nao_informado'];

      allow delete: if false;
    }

    match /objects/{objectId} {
      allow get: if resource != null
        && (isPublicObjectStatus(resource.data.status)
          || (signedIn() && resource.data.createdBy == request.auth.uid)
          || isAdmin());

      allow list: if isPublicObjectStatus(resource.data.status) || isAdmin();

      allow create: if signedIn()
        && objectId.matches('^OBJ-[0-9A-HJKMNP-TV-Z]{8}$')
        && request.resource.data.keys().hasOnly([
          'code', 'title', 'category', 'description', 'locationFound', 'dateFound', 'notes',
          'status', 'createdBy', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.code == objectId
        && textBetween(request.resource.data.title, 3, 80)
        && request.resource.data.category in ['eletronicos', 'documentos', 'materiais-escolares', 'acessorios', 'vestuario', 'outros']
        && textBetween(request.resource.data.description, 10, 500)
        && textBetween(request.resource.data.locationFound, 3, 120)
        && request.resource.data.dateFound is string
        && request.resource.data.dateFound.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && textBetween(request.resource.data.notes, 0, 300)
        && request.resource.data.status == 'pendente_aprovacao'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /claims/{claimId} {
      allow get: if signedIn()
        && resource != null
        && (resource.data.requesterId == request.auth.uid || isAdmin());

      allow list: if signedIn()
        && (resource.data.requesterId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && claimId.matches('^SOL-[0-9A-HJKMNP-TV-Z]{8}$')
        && request.resource.data.keys().hasOnly([
          'objectId', 'objectCode', 'requesterId', 'message', 'additionalInfo',
          'status', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.objectCode == request.resource.data.objectId
        && textBetween(request.resource.data.message, 30, 1000)
        && textBetween(request.resource.data.additionalInfo, 0, 500)
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && exists(objectPath(request.resource.data.objectId))
        && get(objectPath(request.resource.data.objectId)).data.status == 'disponivel';

      allow update: if isAdmin() && resource.data.requesterId != request.auth.uid;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'targetType', 'targetId', 'actorId', 'actorRole', 'details', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == 'admin'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
